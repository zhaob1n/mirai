using Gtk 4.0;
using Adw 1;

template $MiraiFoxPickerDialog: Adw.Dialog {
  title: _("Download from Fox");
  content-width: 640;
  content-height: 860;

  child: Adw.ToolbarView toolbar {
    // Down until a page of records or searches with another to turn to is on screen:
    // sync_pager.
    reveal-bottom-bars: false;

    [top]
    Adw.HeaderBar {}

    content: Gtk.Box {
      orientation: vertical;

      // Clamped and inset as an AdwPreferencesPage clamps and insets its groups, so the
      // search lines up with the records under it.
      Adw.Clamp {
        child: Gtk.Box {
          orientation: vertical;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;

          Gtk.Box {
            spacing: 8;

            Gtk.SearchEntry entry {
              placeholder-text: _("Exact Fox nickname or numeric UID");
              hexpand: true;
            }

            Gtk.Button search_button {
              label: C_("verb", "Search");
              sensitive: false;
            }
          }

          Gtk.Label {
            label: _("Public records only · Fox exposes at most the latest 200 games");
            xalign: 0;
            wrap: true;
            margin-top: 6;
            margin-bottom: 6;

            styles [
              "dim-label",
              "caption",
            ]
          }
        };
      }

      Adw.Banner banner {
        title: _("Fox request failed");
        revealed: false;
      }

      Adw.ViewStack stack {
        enable-transitions: true;
        vexpand: true;

        Adw.StatusPage status_page {
          icon-name: "system-search-symbolic";
          title: _("Find a Fox Player");
          description: _("Enter an exact nickname or UID to browse their recent public games.");
        }

        Adw.StatusPage loading_page {
          title: _("Searching Fox");
          description: _("This may take a few seconds.");

          paintable: Adw.SpinnerPaintable {};
        }

        // Searches already made, answered from the saved records without asking Fox. Ten a
        // page, like the records; the rows are added as the history needs them.
        Adw.PreferencesPage recent_page {
          title: _("Recent Searches");

          Adw.PreferencesGroup recent_group {
            title: _("Recent Searches");
          }
        }

        // Ten records a page. The rows are built once and refilled in place: a page turn
        // changes their text and nothing else.
        Adw.PreferencesPage results_page {
          title: _("Recent Games");

          Adw.PreferencesGroup result_group {
            title: _("Recent Games");

            header-suffix: Gtk.Button refresh_button {
              icon-name: "view-refresh-symbolic";
              tooltip-text: _("Search Fox Again");
              valign: center;

              styles [
                "flat",
              ]
            };
          }
        }
      }
    };

    // Revealed with the records or the recent searches, when there is more than one page of
    // them.
    [bottom]
    Gtk.CenterBox pager {
      styles [
        "toolbar",
      ]

      [start]
      Gtk.Button newer_button {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Previous Page");
      }

      [center]
      Gtk.Label page_label {
        // Which entries are on screen: a live region, so a page turn is announced.
        accessible-role: status;

        styles [
          "dim-label",
          "numeric",
        ]
      }

      [end]
      Gtk.Button older_button {
        icon-name: "go-next-symbolic";
        tooltip-text: _("Next Page");
      }
    }
  };
}
