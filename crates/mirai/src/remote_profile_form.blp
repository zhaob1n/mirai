using Gtk 4.0;
using Adw 1;

template $MiraiRemoteProfileForm : Adw.PreferencesPage {
  title: _("Engine Profile");

  Adw.PreferencesGroup {
    Adw.EntryRow name_row {
      title: _("Name");
    }
  }

  Adw.PreferencesGroup {
    title: _("Server");
    description: _("For example 192.168.1.10, or 192.168.1.10:9678. The port defaults to 9678.");

    Adw.EntryRow url_row {
      title: _("Server Address");
    }

    Adw.PasswordEntryRow token_row {
      title: _("Token");
    }

    Adw.EntryRow engine_row {
      title: _("Engine Name (Optional)");
    }
  }

  Adw.PreferencesGroup {
    title: _("Certificate");
    description: _("mirai checks the certificate before sending the token. Test the connection and compare the fingerprint with the one mirai-server printed at startup.");

    Adw.ActionRow trust_row {
      title: _("Pinned Fingerprint");
      use-markup: false;
      subtitle-lines: 3;

      [suffix]
      Gtk.Button test_button {
        label: _("Test Connection");
        valign: center;
      }
    }
  }
}
