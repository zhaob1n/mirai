using Gtk 4.0;
using Adw 1;

template $MiraiLabelEditorDialog : Adw.Dialog {
  /* Translators: a text mark on an intersection. */
  title: C_("mark", "Edit Label");
  content-width: 360;

  child: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Gtk.Button cancel_button {
        label: _("Cancel");
      }

      [end]
      Gtk.Button apply_button {
        /* Translators: a text mark on an intersection. */
        label: C_("mark", "Apply Label");
        styles ["suggested-action"]
      }
    }

    content: Gtk.Box {
      orientation: vertical;
      spacing: 12;
      margin-start: 16;
      margin-end: 16;
      margin-top: 12;
      margin-bottom: 16;

      Gtk.Entry entry {
        /* Translators: a text mark on an intersection. */
        placeholder-text: C_("mark", "Label text");
        hexpand: true;
        enable-undo: true;
      }

      Gtk.Label {
        /* Translators: a text mark on an intersection. */
        label: _("Leave empty to remove the label");
        wrap: true;
        xalign: 0;
        styles ["caption"]
      }
    };
  };
}
