using Gtk 4.0;

template $MiraiAnalysisPanel: Gtk.Box {
  orientation: vertical;

  Gtk.Box {
    orientation: vertical;
    spacing: 2;
    hexpand: true;
    margin-start: 12;
    margin-end: 12;
    margin-top: 8;
    margin-bottom: 8;

    Gtk.Label readout {
      label: _("No analysis");
      xalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "heading",
      ]
    }

    Gtk.Label detail {
      xalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "dim-label",
      ]
    }
  }

  Gtk.ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    child: Gtk.ColumnView columns {
      show-column-separators: false;
      show-row-separators: false;
      single-click-activate: false;
      vexpand: true;

      styles [
        "mirai-candidates",
      ]
    };
  }

  Gtk.Box blunder_group {
    visible: false;
    orientation: vertical;

    Gtk.Separator {}

    Gtk.Expander blunder_expander {
      label: _("Blunders");
      expanded: true;
      margin-start: 12;
      margin-end: 12;
      margin-bottom: 8;

      styles [
        "mirai-blunders",
      ]

      Gtk.ScrolledWindow {
        propagate-natural-height: true;
        max-content-height: 240;
        hscrollbar-policy: never;

        child: Gtk.ListBox blunder_list {
          selection-mode: none;
        };
      }
    }
  }
}
