using Gtk 4.0;

template $MiraiAnalysisPanel: Gtk.Box {
  orientation: vertical;

  Gtk.Box {
    orientation: vertical;
    spacing: 2;
    hexpand: true;
    margin-start: 12;
    margin-end: 12;
    margin-top: 8;
    margin-bottom: 8;

    Gtk.Box {
      spacing: 6;

      Gtk.Label readout {
        label: _("No Analysis");
        xalign: 0;
        hexpand: true;

        styles [
          "heading",
        ]
      }

      Gtk.MenuButton {
        icon-name: "view-more-symbolic";
        tooltip-text: _("Analysis Options");
        menu-model: analysis_options;

        accessibility {
          label: _("Analysis Options");
        }
      }
    }

    Gtk.Label metrics {
      visible: false;
      xalign: 0;
      hexpand: true;

      styles [
        "title-4",
        "mirai-position",
      ]
    }

    Gtk.Label detail {
      xalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "caption",
        "dim-label",
      ]
    }
  }

  Gtk.ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    child: Gtk.ColumnView columns {
      show-column-separators: false;
      show-row-separators: false;
      single-click-activate: false;
      vexpand: true;

      styles [
        "mirai-candidates",
      ]
    };
  }

  Gtk.Box blunder_group {
    visible: false;
    orientation: vertical;

    Gtk.Separator {}

    Gtk.Expander blunder_expander {
      label: _("Blunders");
      expanded: true;

      styles [
        "mirai-blunders",
      ]

      Gtk.ScrolledWindow {
        propagate-natural-height: true;
        max-content-height: 240;
        hscrollbar-policy: never;

        child: Gtk.ListBox blunder_list {
          selection-mode: none;
          show-separators: true;
        };
      }
    }
  }
}

menu analysis_options {
  section {
    item ("Show Detailed Columns", "win.toggle-candidate-details")
  }
}
