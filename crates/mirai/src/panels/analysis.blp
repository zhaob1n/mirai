using Gtk 4.0;

template $MiraiAnalysisPanel: Gtk.Box {
  orientation: vertical;

  Gtk.Box {
    orientation: vertical;
    spacing: 2;
    hexpand: true;
    margin-start: 12;
    margin-end: 12;
    margin-top: 8;
    margin-bottom: 8;

    Gtk.Label readout {
      label: _("No Analysis");
      xalign: 0;
      hexpand: true;

      styles [
        "heading",
      ]
    }

    Gtk.Label metrics {
      visible: false;
      xalign: 0;
      hexpand: true;

      styles [
        "title-4",
        "mirai-position",
      ]
    }

    Gtk.Label detail {
      xalign: 0;
      hexpand: true;
      wrap: true;
      wrap-mode: word_char;

      styles [
        "caption",
        "dim-label",
      ]
    }

    // What the panel is empty of, offered as the two ways to fill it rather than described.
    // Stacked: side by side their labels need more than the 300 sp sidebar.
    Gtk.Box start_actions {
      visible: false;
      orientation: vertical;
      spacing: 6;
      margin-top: 6;

      Gtk.Button {
        label: _("Analyse Position");
        action-name: "win.toggle-analysis";
        tooltip-text: _("Analyse this position and each one you move to (Space)");

        styles [
          "suggested-action",
        ]
      }

      Gtk.Button analyse_game_button {
        label: _("Analyse Game");
        action-name: "win.analyse-game";
        tooltip-text: _("Analyse every move of the main line (Ctrl+A)");
      }
    }
  }

  Gtk.ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    child: Gtk.ColumnView columns {
      show-column-separators: false;
      show-row-separators: false;
      single-click-activate: false;
      vexpand: true;

      styles [
        "mirai-candidates",
      ]
    };
  }

  Gtk.Box blunder_group {
    visible: false;
    orientation: vertical;

    Gtk.Separator {}

    Gtk.Expander blunder_expander {
      label: _("Blunders");
      expanded: true;

      styles [
        "mirai-blunders",
      ]

      Gtk.ScrolledWindow {
        propagate-natural-height: true;
        max-content-height: 240;
        hscrollbar-policy: never;

        child: Gtk.ListBox blunder_list {
          selection-mode: none;
          show-separators: true;
        };
      }
    }
  }
}

menu column_menu {
  section {
    item ("_Loss and Prior Columns", "win.toggle-candidate-details")
  }
}
