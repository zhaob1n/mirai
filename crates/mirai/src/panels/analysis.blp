using Gtk 4.0;

template $MiraiAnalysisPanel: Gtk.Box {
  orientation: vertical;

  Gtk.Box {
    orientation: vertical;
    hexpand: true;
    margin-start: 12;
    margin-end: 12;
    margin-top: 6;
    margin-bottom: 6;

    // One line: whose moves these are, as a stone, and how far the search has got. The
    // position's own win rate is the graph's; the pick's numbers are the first row.
    Gtk.Box status {
      spacing: 4;

      // The blunder rows' emoji stones, kept out of `detail` so dim-label does not fade them.
      // An image to assistive technology: a label would read out the emoji, not its name.
      Gtk.Label to_move {
        visible: false;
        accessible-role: img;

        styles [
          "caption",
        ]
      }

      Gtk.Label detail {
        xalign: 0;
        hexpand: true;
        wrap: true;
        wrap-mode: word_char;

        styles [
          "caption",
          "dim-label",
          "mirai-position",
        ]
      }
    }

    // What the panel is empty of, offered as the two ways to fill it rather than described.
    // Stacked: side by side their labels need more than the 300 sp sidebar.
    Gtk.Box start_actions {
      visible: false;
      orientation: vertical;
      spacing: 6;
      margin-top: 6;

      Gtk.Button {
        label: _("Analyse Position");
        action-name: "win.toggle-analysis";
        tooltip-text: _("Analyse this position and each one you move to (Space)");

        styles [
          "suggested-action",
        ]
      }

      Gtk.Button analyse_game_button {
        label: _("Analyse Game");
        action-name: "win.analyse-game";
        tooltip-text: _("Analyse every move of the main line (Ctrl+A)");
      }
    }
  }

  Gtk.ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    child: Gtk.ColumnView columns {
      show-column-separators: false;
      show-row-separators: false;
      single-click-activate: false;
      vexpand: true;

      styles [
        "mirai-candidates",
      ]
    };
  }

  Gtk.Box blunder_group {
    visible: false;
    orientation: vertical;

    Gtk.Separator {}

    Gtk.Expander blunder_expander {
      label: _("Blunders");
      expanded: true;

      styles [
        "mirai-blunders",
      ]

      Gtk.ScrolledWindow {
        propagate-natural-height: true;
        max-content-height: 240;
        hscrollbar-policy: never;

        child: Gtk.ListBox blunder_list {
          selection-mode: none;
          show-separators: true;
        };
      }
    }
  }
}

menu column_menu {
  section {
    item ("_Loss and Prior Columns", "win.toggle-candidate-details")
  }
}
