using Gtk 4.0;
using Adw 1;

template $MiraiWindow: Adw.ApplicationWindow {
  title: "mirai";
  default-width: 1280;
  default-height: 860;

  content: Adw.ToastOverlay toasts {
    child: Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar header_bar {
        title-widget: Adw.WindowTitle title {
          title: _("Untitled");
        };

        [start]
        Adw.SplitButton {
          icon-name: "folder-download-symbolic";
          tooltip-text: _("Download a Public Game Record (Ctrl+Shift+O)");
          dropdown-tooltip: _("Open a File or Paste SGF");
          action-name: "win.download-record";
          menu-model: open_menu;

          accessibility {
            label: _("Download Game Record");
          }
        }

        [start]
        Gtk.Button {
          tooltip-text: _("New Game (Ctrl+N)");
          action-name: "win.new-game";
          icon-name: "document-new-symbolic";

          accessibility {
            label: _("New Game…");
          }
        }

        [start]
        Gtk.Separator {
          styles [
            "spacer",
          ]
        }

        [start]
        Gtk.MenuButton engine_menu {
          tooltip-text: _("Analysis Engine");

          child: Adw.ButtonContent engine_content {
            icon-name: "applications-engineering-symbolic";
            label: _("No Engine");
            can-shrink: true;
          };

          accessibility {
            label: _("Analysis Engine");
          }
        }

        [start]
        Gtk.ToggleButton live_toggle {
          icon-name: "media-playback-start-symbolic";
          action-name: "win.toggle-analysis";
          tooltip-text: _("Start Live Analysis (Space)");

          accessibility {
            label: _("Live Analysis");
          }
        }

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;

          accessibility {
            label: _("Main Menu");
          }
        }

        [end]
        Gtk.ToggleButton sidebar_toggle {
          icon-name: "sidebar-show-right-symbolic";
          action-name: "win.toggle-sidebar";
          tooltip-text: _("Hide Sidebar (F9)");

          accessibility {
            label: _("Sidebar");
          }
        }
      }

      content: Adw.OverlaySplitView split {
        sidebar-position: end;
        show-sidebar: true;

        content: Adw.ToolbarView board_view {
          content: Gtk.Box content_box {
            orientation: vertical;
            hexpand: true;
            vexpand: true;

            Gtk.Box banner_slot {
              orientation: vertical;
            }

            Gtk.Revealer editor_revealer {
              reveal-child: true;
              transition-type: slide_down;

              Adw.Bin editor_toolbar {
                styles [
                  "toolbar",
                ]

                Adw.WrapBox {
                  child-spacing: 12;
                  line-spacing: 6;
                  line-homogeneous: true;
                  hexpand: true;

                  Gtk.Box {
                    spacing: 0;
                    valign: center;

                    accessibility {
                      label: _("Edit History");
                    }

                    Gtk.Button {
                      icon-name: "edit-undo-symbolic";
                      action-name: "win.undo";
                      tooltip-text: _("Undo the Last Edit (Ctrl+Z)");

                      accessibility {
                        label: _("Undo");
                      }
                    }

                    Gtk.Button {
                      icon-name: "edit-redo-symbolic";
                      action-name: "win.redo";
                      tooltip-text: _("Redo the Last Edit (Ctrl+Shift+Z)");

                      accessibility {
                        label: _("Redo");
                      }
                    }
                  }

                  // Beside Play, whose icon already shows the side to move; pressing the
                  // Play toggle itself only ever selects the tool.
                  Gtk.Button {
                    icon-name: "mirai-swap-symbolic";
                    valign: center;
                    action-name: "win.switch-to-play";
                    tooltip-text: _("Switch Side to Play (T)");

                    styles [
                      "flat",
                    ]

                    accessibility {
                      label: _("Switch Side to Play");
                    }
                  }

                  Adw.ToggleGroup stone_tools {
                    valign: center;

                    accessibility {
                      label: _("Stone Tools");
                    }

                    Adw.Toggle play_tool {
                      name: "play";
                      label: C_("verb", "Play");

                      child: Gtk.Image play_tool_icon {
                        icon-name: "mirai-play-black";
                        pixel-size: 24;
                        // The toggle supplies the accessible label.
                        accessible-role: presentation;
                      };

                      tooltip: _("Play — Left-Click to Play, Right-Click to Take Back");
                    }

                    Adw.Toggle {
                      name: "setup-black";
                      label: _("Setup Black");

                      child: Gtk.Image {
                        icon-name: "mirai-stone-black";
                        accessible-role: presentation;
                      };

                      tooltip: _("Setup Black — Left-Click Black, Right-Click White; Matching Color Removes the Stone");
                    }

                    Adw.Toggle {
                      name: "setup-white";
                      label: _("Setup White");

                      child: Gtk.Image {
                        icon-name: "mirai-stone-white";
                        accessible-role: presentation;
                      };

                      tooltip: _("Setup White — Left-Click White, Right-Click Black; Matching Color Removes the Stone");
                    }
                  }

                  Adw.ToggleGroup mark_tools {
                    valign: center;

                    styles [
                      "flat",
                    ]

                    accessibility {
                      label: _("Marks");
                    }

                    Adw.Toggle {
                      name: "triangle";
                      label: C_("mark", "Triangle");

                      child: Gtk.Image {
                        icon-name: "mirai-mark-triangle-symbolic";
                        accessible-role: presentation;
                      };

                      tooltip: C_("mark", "Triangle");
                    }

                    Adw.Toggle {
                      name: "square";
                      label: C_("mark", "Square");

                      child: Gtk.Image {
                        icon-name: "mirai-mark-square-symbolic";
                        accessible-role: presentation;
                      };

                      tooltip: C_("mark", "Square");
                    }

                    Adw.Toggle {
                      name: "circle";
                      label: C_("mark", "Circle");

                      child: Gtk.Image {
                        icon-name: "mirai-mark-circle-symbolic";
                        accessible-role: presentation;
                      };

                      tooltip: C_("mark", "Circle");
                    }

                    Adw.Toggle {
                      name: "cross";
                      label: C_("mark", "Cross");

                      child: Gtk.Image {
                        icon-name: "mirai-mark-cross-symbolic";
                        accessible-role: presentation;
                      };

                      tooltip: C_("mark", "Cross");
                    }

                    Adw.Toggle {
                      name: "label";
                      label: C_("mark", "Label");

                      child: Gtk.Image {
                        icon-name: "mirai-mark-label-symbolic";
                        accessible-role: presentation;
                      };

                      tooltip: C_("mark", "Label");
                    }

                    Adw.Toggle {
                      name: "erase-mark";
                      label: _("Erase Mark");

                      child: Gtk.Image {
                        icon-name: "mirai-eraser-symbolic";
                        accessible-role: presentation;
                      };
                    }
                  }
                }
              }
            }

            Gtk.Paned content {
              orientation: vertical;
              resize-start-child: true;
              resize-end-child: false;
              shrink-start-child: false;
              shrink-end-child: false;
              hexpand: true;
              vexpand: true;
            }
          };

          [bottom]
          Gtk.Box board_bars {
            orientation: vertical;

            styles [
              "toolbar",
            ]

            Gtk.Box nav {
              orientation: horizontal;
              spacing: 6;
              margin-start: 8;
              margin-end: 8;
              margin-top: 4;
              margin-bottom: 4;

              Gtk.Button {
                icon-name: "go-first-symbolic";
                action-name: "win.first";
                tooltip-text: _("First Move (Home)");

                accessibility {
                  label: _("First Move");
                }
              }

              Gtk.Button {
                icon-name: "go-previous-symbolic";
                action-name: "win.prev";
                tooltip-text: _("Previous Move (Left)");

                accessibility {
                  label: _("Previous Move");
                }
              }

              Gtk.Button {
                icon-name: "go-next-symbolic";
                action-name: "win.next";
                tooltip-text: _("Next Move (Right)");

                accessibility {
                  label: _("Next Move");
                }
              }

              Gtk.Button {
                icon-name: "go-last-symbolic";
                action-name: "win.last";
                tooltip-text: _("Last Move (End)");

                accessibility {
                  label: _("Last Move");
                }
              }

              Gtk.Box {
                spacing: 0;

                styles [
                  "linked",
                ]

                Gtk.Button {
                  icon-name: "go-up-symbolic";
                  action-name: "win.branch-prev";
                  tooltip-text: _("Previous Variation (Up)");

                  accessibility {
                    label: _("Previous Variation");
                  }
                }

                Gtk.Button {
                  icon-name: "go-down-symbolic";
                  action-name: "win.branch-next";
                  tooltip-text: _("Next Variation (Down)");

                  accessibility {
                    label: _("Next Variation");
                  }
                }
              }

              Gtk.Scale move_scale {
                orientation: horizontal;
                hexpand: true;
                draw-value: false;
                round-digits: 0;
                digits: 0;

                adjustment: Gtk.Adjustment {
                  lower: 0;
                  upper: 1;
                  value: 0;
                };

                accessibility {
                  label: _("Move Number");
                }
              }

              Gtk.Label move_position {
                width-chars: 16;
                max-width-chars: 16;
                ellipsize: end;

                styles [
                  "mirai-position",
                ]
              }

              Gtk.ToggleButton editor_toggle {
                icon-name: "document-edit-symbolic";
                tooltip-text: _("Editing Tools");
                action-name: "win.toggle-editor";

                accessibility {
                  label: _("Editing Tools");
                }
              }
            }

            Gtk.Box play_bar {
              visible: false;
              spacing: 12;
              halign: center;
              margin-start: 8;
              margin-end: 8;
              margin-top: 4;
              margin-bottom: 4;
              // Clocks sit with the play controls: both exist only while a game is running, and a
              // variable-width element in the header made the title jump mid-game.
              Gtk.Box clock_box {
                visible: false;
                spacing: 4;

                Gtk.Label clock_black {
                  label: "–:––";

                  styles [
                    "mirai-clock",
                  ]
                }

                Gtk.Label clock_white {
                  label: "–:––";

                  styles [
                    "mirai-clock",
                  ]
                }
              }

              Gtk.Box play_controls {
                visible: false;
                homogeneous: true;
                spacing: 6;

                Gtk.Button undo_button {
                  label: _("Undo");
                  action-name: "win.undo";
                  tooltip-text: _("Undo the Last Turn (Ctrl+Z)");
                }

                Gtk.Button pass_button {
                  label: C_("verb", "Pass");
                  action-name: "win.pass";
                  tooltip-text: _("Pass This Turn (P)");
                }

                Gtk.Button retry_button {
                  label: _("Retry");
                  action-name: "win.retry-ai";
                  tooltip-text: _("Ask the Engine to Move Again");
                  visible: false;

                  styles [
                    "suggested-action",
                  ]
                }

                Gtk.Button resign_button {
                  label: _("Resign");
                  action-name: "win.resign";
                  tooltip-text: _("Resign the Current Game");

                  styles [
                    "destructive-action",
                  ]
                }
              }
            }
          }
        };

        sidebar: Adw.ToolbarView sidebar_view {
          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
            show-end-title-buttons: false;

            title-widget: Adw.InlineViewSwitcher {
              stack: sidebar_stack;
            };
          }

          content: Adw.ViewStack sidebar_stack {};
        };
      };
    };
  };
}

menu open_menu {
  section {
    item (_("_Open File…"), "win.open")
    // View-scoped shortcuts are not application accelerators, so the menu is told the hint.
    item {
      label: _("_Paste SGF");
      action: "win.paste-sgf";
      accel: "<Control>v";
    }
  }
}

menu primary_menu {
  section {
    item (_("_Clear Board"), "win.clear-board")
    item (_("_Save"), "win.save")
    item (_("Save _As…"), "win.save-as")
    item {
      label: _("_Copy SGF");
      action: "win.copy-sgf";
      accel: "<Control>c";
    }
  }

  section {
    item {
      label: _("Analyse _Game");
      action: "win.analyse-game";
      accel: "<Control>a";
    }
    item (_("_Estimate Score"), "win.score")
  }

  submenu {
    label: _("_View");

    section {
      item (_("_Sidebar"), "win.toggle-sidebar")
      item {
        label: _("_Win-Rate Graph");
        action: "win.toggle-graph";
        accel: "g";
      }
      item (_("_Editing Tools"), "win.toggle-editor")
      item (_("_Loss and Prior Columns"), "win.toggle-candidate-details")
    }

    section {
      item {
        label: _("_Coordinates");
        action: "win.toggle-coords";
        accel: "c";
      }

      item {
        label: _("_Move Numbers");
        action: "win.toggle-move-numbers";
        accel: "n";
      }
    }

    section {
      item {
        label: _("_Ownership Overlay");
        action: "win.toggle-ownership";
        accel: "o";
      }

      item {
        label: _("_Policy Overlay");
        action: "win.toggle-policy";
        accel: "y";
      }
    }
  }

  section {
    item (_("_Preferences"), "win.preferences")
    item (_("_Keyboard Shortcuts"), "win.shortcuts")
    /* Translators: mirai is the application name; do not translate it. */
    item (_("_About mirai"), "win.about")
  }
}
