using Gtk 4.0;
using Adw 1;

template $MiraiWindow: Adw.ApplicationWindow {
  title: _("mirai");
  default-width: 1280;
  default-height: 860;

  content: Adw.ToastOverlay toasts {
    child: Adw.ToolbarView toolbar {
      [top]
      Adw.HeaderBar {
        title-widget: Adw.WindowTitle title {
          title: _("Untitled");
        };

        [start]
        Adw.SplitButton {
          icon-name: "document-open-symbolic";
          tooltip-text: _("Open an SGF Game Record (Ctrl+O)");
          action-name: "win.open";
          menu-model: open_menu;

          accessibility {
            label: _("Open Game Record");
          }
        }

        [start]
        Gtk.Button {
          icon-name: "folder-download-symbolic";
          tooltip-text: _("Download a Public Game Record from Fox (Ctrl+Shift+O)");
          action-name: "win.download-fox";

          accessibility {
            label: _("Download from Fox");
          }
        }

        [start]
        Gtk.Button {
          tooltip-text: _("New Game (Ctrl+N)");
          action-name: "win.new-game";
          icon-name: "document-new-symbolic";

          accessibility {
            label: _("New Game…");
          }
        }

        [start]
        Gtk.Separator {
          styles [
            "spacer",
          ]
        }

        [start]
        Gtk.MenuButton engine_menu {
          tooltip-text: _("Analysis Engine");

          child: Adw.ButtonContent engine_content {
            icon-name: "applications-engineering-symbolic";
            label: _("No Engine");
          };

          accessibility {
            label: _("Analysis Engine");
          }
        }

        [start]
        Gtk.ToggleButton live_toggle {
          icon-name: "media-playback-start-symbolic";
          tooltip-text: _("Start Live Analysis (Space)");

          accessibility {
            label: _("Live Analysis");
          }
        }

        [end]
        Gtk.MenuButton {
          icon-name: "open-menu-symbolic";
          tooltip-text: _("Main Menu");
          menu-model: primary_menu;

          accessibility {
            label: _("Main Menu");
          }
        }

        [end]
        Gtk.ToggleButton sidebar_toggle {
          icon-name: "sidebar-show-right-symbolic";
          tooltip-text: _("Hide Sidebar (F9)");

          accessibility {
            label: _("Sidebar");
          }
        }
      }

      content: Adw.OverlaySplitView split {
        sidebar-position: end;
        show-sidebar: true;
        min-sidebar-width: 320;
        max-sidebar-width: 520;

        content: Gtk.Box content_box {
          orientation: vertical;
          hexpand: true;
          vexpand: true;

          Gtk.Box banner_slot {
            orientation: vertical;
          }

          Gtk.Box editor_toolbar {
            styles [
              "toolbar",
            ]

            Adw.WrapBox {
              child-spacing: 12;
              line-spacing: 6;
              line-homogeneous: true;
              hexpand: true;

              Gtk.Box {
                spacing: 0;
                valign: center;

                accessibility {
                  label: _("Edit History");
                }

                Gtk.Button {
                  icon-name: "edit-undo-symbolic";
                  action-name: "win.undo";
                  tooltip-text: _("Undo the Last Edit (Ctrl+Z)");

                  accessibility {
                    label: _("Undo");
                  }
                }

                Gtk.Button {
                  icon-name: "edit-redo-symbolic";
                  action-name: "win.redo";
                  tooltip-text: _("Redo the Last Edit (Ctrl+Shift+Z)");

                  accessibility {
                    label: _("Redo");
                  }
                }
              }

              Adw.ToggleGroup stone_tools {
                valign: center;

                accessibility {
                  label: _("Stone Tools");
                }

                Adw.Toggle play_tool {
                  name: "play";
                  label: _("Play");

                  child: Gtk.Image play_tool_icon {
                    icon-name: "mirai-play-black";
                    pixel-size: 24;
                    // The toggle supplies the accessible label.
                    accessible-role: presentation;
                  };

                  tooltip: _("Play — Left-click to Play, Right-click to Take Back");
                }

                Adw.Toggle {
                  name: "setup-black";
                  label: _("Setup Black");

                  child: Gtk.Image {
                    icon-name: "mirai-stone-black";
                    accessible-role: presentation;
                  };

                  tooltip: _("Setup Black — Left-click Black, Right-click White; Matching Color Removes the Stone");
                }

                Adw.Toggle {
                  name: "setup-white";
                  label: _("Setup White");

                  child: Gtk.Image {
                    icon-name: "mirai-stone-white";
                    accessible-role: presentation;
                  };

                  tooltip: _("Setup White — Left-click White, Right-click Black; Matching Color Removes the Stone");
                }
              }

              Adw.ToggleGroup mark_tools {
                valign: center;

                styles [
                  "flat",
                ]

                accessibility {
                  label: _("Marks");
                }

                Adw.Toggle {
                  name: "triangle";
                  label: _("Triangle");

                  child: Gtk.Image {
                    icon-name: "mirai-mark-triangle-symbolic";
                    accessible-role: presentation;
                  };

                  tooltip: _("Triangle");
                }

                Adw.Toggle {
                  name: "square";
                  label: _("Square");

                  child: Gtk.Image {
                    icon-name: "mirai-mark-square-symbolic";
                    accessible-role: presentation;
                  };

                  tooltip: _("Square");
                }

                Adw.Toggle {
                  name: "circle";
                  label: _("Circle");

                  child: Gtk.Image {
                    icon-name: "mirai-mark-circle-symbolic";
                    accessible-role: presentation;
                  };

                  tooltip: _("Circle");
                }

                Adw.Toggle {
                  name: "cross";
                  label: _("Cross");

                  child: Gtk.Image {
                    icon-name: "mirai-mark-cross-symbolic";
                    accessible-role: presentation;
                  };

                  tooltip: _("Cross");
                }

                Adw.Toggle {
                  name: "label";
                  label: _("Label");

                  child: Gtk.Image {
                    icon-name: "mirai-mark-label-symbolic";
                    accessible-role: presentation;
                  };

                  tooltip: _("Label");
                }

                Adw.Toggle {
                  name: "erase-mark";
                  label: _("Erase Mark");

                  child: Gtk.Image {
                    icon-name: "mirai-eraser-symbolic";
                    accessible-role: presentation;
                  };
                }
              }
            }

            Gtk.Button board_menu_button {
              icon-name: "view-more-symbolic";
              valign: start;
              action-name: "win.board-menu";
              tooltip-text: _("Board Menu — Also Available with Shift+Right-click");

              accessibility {
                label: _("Board Menu");
              }
            }
          }

          Gtk.Paned content {
            orientation: vertical;
            resize-start-child: true;
            resize-end-child: false;
            shrink-start-child: false;
            shrink-end-child: false;
            hexpand: true;
            vexpand: true;
          }
        };

        sidebar: Adw.ToolbarView sidebar_view {
          width-request: 340;

          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
            show-end-title-buttons: false;

            title-widget: Adw.ViewSwitcher {
              stack: sidebar_stack;
              policy: wide;
            };
          }

          content: Adw.ViewStack sidebar_stack {};
        };
      };

      [bottom]
      Gtk.Box nav {
        orientation: horizontal;
        spacing: 6;
        margin-start: 8;
        margin-end: 8;
        margin-top: 4;
        margin-bottom: 4;

        Gtk.Button {
          icon-name: "go-first-symbolic";
          action-name: "win.first";
          tooltip-text: _("First Move (Home)");

          accessibility {
            label: _("First Move");
          }
        }

        Gtk.Button {
          icon-name: "go-previous-symbolic";
          action-name: "win.prev";
          tooltip-text: _("Previous Move (Left)");

          accessibility {
            label: _("Previous Move");
          }
        }

        Gtk.Button {
          icon-name: "go-next-symbolic";
          action-name: "win.next";
          tooltip-text: _("Next Move (Right)");

          accessibility {
            label: _("Next Move");
          }
        }

        Gtk.Button {
          icon-name: "go-last-symbolic";
          action-name: "win.last";
          tooltip-text: _("Last Move (End)");

          accessibility {
            label: _("Last Move");
          }
        }

        Gtk.Box {
          spacing: 0;

          styles [
            "linked",
          ]

          Gtk.Button {
            icon-name: "go-up-symbolic";
            action-name: "win.branch-prev";
            tooltip-text: _("Previous Variation (Up)");

            accessibility {
              label: _("Previous Variation");
            }
          }

          Gtk.Button {
            icon-name: "go-down-symbolic";
            action-name: "win.branch-next";
            tooltip-text: _("Next Variation (Down)");

            accessibility {
              label: _("Next Variation");
            }
          }
        }

        // Clocks sit with the play controls: both exist only while a game is running, and a
        // variable-width element in the header made the title jump mid-game.
        Gtk.Box clock_box {
          visible: false;
          spacing: 4;

          Gtk.Label clock_black {
            label: _("–:––");

            styles [
              "mirai-clock",
            ]
          }

          Gtk.Label clock_white {
            label: _("–:––");

            styles [
              "mirai-clock",
            ]
          }
        }

        Gtk.Box play_controls {
          visible: false;
          homogeneous: true;
          spacing: 6;

          Gtk.Button undo_button {
            label: _("Undo");
            action-name: "win.undo";
            tooltip-text: _("Undo the Last Turn (Ctrl+Z)");
          }

          Gtk.Button pass_button {
            label: _("Pass");
            action-name: "win.pass";
            tooltip-text: _("Pass This Turn (P)");
          }

          Gtk.Button resign_button {
            label: _("Resign");
            action-name: "win.resign";
            tooltip-text: _("Resign the Current Game");

            styles [
              "destructive-action",
            ]
          }
        }

        Gtk.Scale move_scale {
          orientation: horizontal;
          hexpand: true;
          draw-value: false;
          round-digits: 0;
          digits: 0;

          adjustment: Gtk.Adjustment {
            lower: 0;
            upper: 1;
            value: 0;
          };

          accessibility {
            label: _("Move Number");
          }
        }

        Gtk.Label readout {
          label: _("—");
          tooltip-text: _("Side to Move, Win Rate, Score Lead, Visits, and Search Speed");

          styles [
            "mirai-readout",
          ]
        }
      }
    };
  };
}

menu open_menu {
  section {
    item ("_Open File…", "win.open")
    item ("_Paste SGF", "win.paste-sgf")
    item ("_Clear Board", "win.clear-board")
  }
}

menu primary_menu {
  section {
    item ("_Clear Board", "win.clear-board")
    item ("_Save", "win.save")
    item ("Save _As…", "win.save-as")
    item ("_Copy SGF", "win.copy-sgf")
  }

  section {
    item ("Analyse _Game", "win.analyse-game")
    item ("_Estimate Score", "win.score")
  }

  submenu {
    label: _("_View");

    section {
      item ("_Sidebar", "win.toggle-sidebar")
    }

    section {
      item ("_Coordinates", "win.toggle-coords")
      item ("_Move Numbers", "win.toggle-move-numbers")
    }

    section {
      item ("_Ownership Overlay", "win.toggle-ownership")
      item ("_Policy Overlay", "win.toggle-policy")
    }
  }

  section {
    item ("_Preferences", "win.preferences")
    item ("_Keyboard Shortcuts", "win.shortcuts")
    item ("_About mirai", "win.about")
  }
}
