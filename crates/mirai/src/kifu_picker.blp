using Gtk 4.0;
using Adw 1;

template $MiraiKifuPickerDialog: Adw.Dialog {
  title: _("Download Game Record");
  content-width: 640;
  content-height: 860;

  child: Adw.ToolbarView toolbar {
    // Down until a page of records or searches with another to turn to is on screen:
    // sync_pager.
    reveal-bottom-bars: false;

    [top]
    // The server the entry searches stands where the title would: below it, it cost the
    // tenth record of a page its room. Rust keeps the entry's placeholder, the caption and
    // the status page in step with it; the dialog's title still names it to a screen reader.
    Adw.HeaderBar {
      title-widget: Adw.ToggleGroup server_group {
        accessibility {
          label: _("Server");
        }

        Adw.Toggle {
          name: "fox";
          label: C_("server", "Fox");
        }

        Adw.Toggle {
          name: "eweiqi";
          label: C_("server", "eWeiqi");
        }

        Adw.Toggle {
          name: "yike";
          label: C_("server", "Yike");
        }
      };
    }

    content: Gtk.Box {
      orientation: vertical;

      // Clamped and inset as an AdwPreferencesPage clamps and insets its groups, so the
      // search lines up with the records under it.
      Adw.Clamp {
        child: Gtk.Box {
          orientation: vertical;
          margin-start: 12;
          margin-end: 12;
          margin-top: 12;

          Gtk.Box {
            spacing: 8;

            Gtk.SearchEntry entry {
              placeholder-text: _("Exact Fox nickname or numeric UID");
              hexpand: true;
            }

            Gtk.Button search_button {
              label: C_("verb", "Search");
              sensitive: false;
            }
          }

          Gtk.Label caption {
            label: _("Public records only · Fox exposes at most the latest 200 games");
            xalign: 0;
            wrap: true;
            margin-top: 6;
            margin-bottom: 6;

            styles [
              "dim-label",
              "caption",
            ]
          }
        };
      }

      Adw.Banner banner {
        title: _("Request failed");
        revealed: false;
      }

      Adw.ViewStack stack {
        enable-transitions: true;
        vexpand: true;

        Adw.StatusPage status_page {
          icon-name: "system-search-symbolic";
          title: _("Find a Fox Player");
          description: _("Enter an exact nickname or UID to browse their recent public games.");
        }

        // Rust words it for what is loading.
        Adw.StatusPage loading_page {
          paintable: Adw.SpinnerPaintable {};
        }

        // Searches already made, answered from the saved records without asking the server.
        // Ten a page, like the records; the rows are added as the history needs them.
        Adw.PreferencesPage recent_page {
          title: _("Recent Searches");

          Adw.PreferencesGroup recent_group {
            title: _("Recent Searches");
          }
        }

        // Ten records a page. The rows are built once and refilled in place: a page turn
        // changes their text and nothing else.
        Adw.PreferencesPage results_page {
          title: _("Recent Games");

          Adw.PreferencesGroup result_group {
            title: _("Recent Games");

            header-suffix: Gtk.Button refresh_button {
              icon-name: "view-refresh-symbolic";
              tooltip-text: _("Search Again");
              valign: center;

              styles [
                "flat",
              ]
            };
          }
        }

        // The players a search may mean, when the server's names are not unique: ten a page,
        // like the records, the rows added as a list first needs them. One line of
        // description, as the records have, so that ten rows still fit.
        Adw.PreferencesPage players_page {
          title: _("Matching Players");

          Adw.PreferencesGroup players_group {
            title: _("Several Players Match");
            description: _("Choose whose games to browse, or search an account number.");
          }
        }
      }
    };

    // Revealed with the records, the recent searches or the players, when there is more
    // than one page of them.
    [bottom]
    Gtk.CenterBox pager {
      styles [
        "toolbar",
      ]

      [start]
      Gtk.Button newer_button {
        icon-name: "go-previous-symbolic";
        tooltip-text: _("Previous Page");
      }

      [center]
      Gtk.Label page_label {
        // Which entries are on screen: a live region, so a page turn is announced.
        accessible-role: status;

        styles [
          "dim-label",
          "numeric",
        ]
      }

      [end]
      Gtk.Button older_button {
        icon-name: "go-next-symbolic";
        tooltip-text: _("Next Page");
      }
    }
  };
}
