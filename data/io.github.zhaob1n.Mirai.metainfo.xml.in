<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<component type="desktop-application">
  <id>io.github.zhaob1n.Mirai</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name translate="no">mirai</name>
  <summary>Analyse, review and play Go with KataGo</summary>
  <developer id="io.github.zhaob1n">
    <name translate="no">Huang Zhaobin</name>
  </developer>
  <description>
    <p>
      A Go board that drives the KataGo engine for live analysis, SGF review and editing,
      and games against the computer. KataGo can run on the same machine or on another one
      on your network.
    </p>
    <ul>
      <li>Live analysis with candidate moves, win rate, score lead and ownership</li>
      <li>Game review with a win-rate graph and a move tree</li>
      <li>Games against KataGo</li>
      <li>SGF editing, and game records downloaded from Fox</li>
    </ul>
    <p>mirai does not include KataGo or a network; supply your own.</p>
  </description>
  <launchable type="desktop-id">io.github.zhaob1n.Mirai.desktop</launchable>
  <url type="homepage">https://github.com/zhaob1n/mirai</url>
  <url type="bugtracker">https://github.com/zhaob1n/mirai/issues</url>
  <url type="vcs-browser">https://github.com/zhaob1n/mirai</url>
  <content_rating type="oars-1.1"/>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <provides>
    <binary>mirai</binary>
    <mediatype>application/x-go-sgf</mediatype>
  </provides>
  <categories>
    <category>Game</category>
    <category>BoardGame</category>
  </categories>
  <releases>
    <release version="0.1.0" date="2026-09-27" type="development"/>
  </releases>
</component>
